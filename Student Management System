#include <iostream>
#include <string>
#include <vector>
#include <algorithm>
#include <iomanip>
#include <fstream>
using namespace std;

/**
 * Student Structure
 * Stores basic information of a student
 */
struct Student {
    string name;    // Student name (no spaces allowed)
    int score;      // Score range: 0-100
    int id;         // Unique student ID
};

/**
 * StudentManager Class
 * Encapsulates all student management operations
 * Provides data persistence and CRUD functionality
 */
class StudentManager {
private:
    vector<Student> stuList;           // Student data storage
    const string FILENAME = "Students.txt";  // Data persistence file

    /**
     * Check if a student ID already exists
     * @param id Student ID to check
     * @return true if ID exists, false otherwise
     */
    bool isIDExist(int id) const {
        for (const auto& s : stuList) {
            if (s.id == id) return true;
        }
        return false;
    }

    /**
     * Save all student data to file
     * Automatically called after data modification
     */
    void saveToFile() const {
        ofstream outFile(FILENAME);
        if (!outFile.is_open()) {
            cout << "[Error] Failed to open file for saving." << endl;
            return;
        }
        for (const auto& s : stuList) {
            outFile << s.name << " " << s.id << " " << s.score << endl;
        }
        outFile.close();
    }

    /**
     * Load student data from file
     * Automatically called when program starts
     */
    void loadFromFile() {
        ifstream inFile(FILENAME);
        if (!inFile.is_open()) {
            return;  // File doesn't exist, start with empty list
        }
        Student stu;
        while (inFile >> stu.name >> stu.id >> stu.score) {
            // Check for duplicate IDs when loading
            if (!isIDExist(stu.id)) {
                stuList.push_back(stu);
            }
        }
        inFile.close();
    }

    // Comparison functions for sorting
    static bool cmpScoreDesc(const Student& a, const Student& b) {
        return a.score > b.score;
    }
    static bool cmpScoreAsc(const Student& a, const Student& b) {
        return a.score < b.score;
    }
    static bool cmpID(const Student& a, const Student& b) {
        return a.id < b.id;
    }
    static bool cmpName(const Student& a, const Student& b) {
        return a.name < b.name;
    }

public:
    /**
     * Constructor: automatically load data from file
     */
    StudentManager() {
        loadFromFile();
    }

    /**
     * Destructor: automatically save data to file
     */
    ~StudentManager() {
        saveToFile();
    }

    /**
     * Add a new student
     */
    void addStudent() {
        Student stu;
        cout << "Please enter the name: ";
        cin >> stu.name;
        cout << "Please enter the id: ";
        cin >> stu.id;

        if (isIDExist(stu.id)) {
            cout << "[Error] The id is duplicated. Please enter again." << endl;
            return;
        }

        cout << "Please enter the score: ";
        cin >> stu.score;
        if (stu.score < 0 || stu.score > 100) {
            cout << "[Error] The score is not reasonable (0-100). Please enter again." << endl;
            return;
        }

        stuList.push_back(stu);
        saveToFile();
        cout << "[Success] You have added a new student successfully!" << endl;
    }

    /**
     * Display all students
     */
    void displayAll() const {
        if (stuList.empty()) {
            cout << "[Info] There is no data for any student." << endl;
            return;
        }
        cout << "\n========== Student List ==========" << endl;
        cout << "Name\t\tID\tScore" << endl;
        cout << "----------------------------------" << endl;
        for (const auto& s : stuList) {
            cout << s.name << "\t\t" << s.id << "\t" << s.score << endl;
        }
        cout << "==================================" << endl;
    }

    /**
     * Sort students by multiple conditions
     */
    void sortStudents() {
        if (stuList.empty()) {
            cout << "[Info] There is no data for any student." << endl;
            return;
        }

        int op = 0;
        cout << "Choose sorting method:" << endl;
        cout << "  1 -- Score (Descending)" << endl;
        cout << "  2 -- Score (Ascending)" << endl;
        cout << "  3 -- ID" << endl;
        cout << "  4 -- Name" << endl;
        cout << "Your choice: ";
        cin >> op;

        switch (op) {
            case 1:
                sort(stuList.begin(), stuList.end(), cmpScoreDesc);
                cout << "[Success] Sorted by score in descending order!" << endl;
                break;
            case 2:
                sort(stuList.begin(), stuList.end(), cmpScoreAsc);
                cout << "[Success] Sorted by score in ascending order!" << endl;
                break;
            case 3:
                sort(stuList.begin(), stuList.end(), cmpID);
                cout << "[Success] Sorted by ID!" << endl;
                break;
            case 4:
                sort(stuList.begin(), stuList.end(), cmpName);
                cout << "[Success] Sorted by name!" << endl;
                break;
            default:
                cout << "[Error] Invalid option." << endl;
                return;
        }
        saveToFile();
    }

    /**
     * Search student by ID
     */
    void searchByID() const {
        if (stuList.empty()) {
            cout << "[Info] There is no data for any student." << endl;
            return;
        }

        int findID;
        cout << "Please enter the student ID to search: ";
        cin >> findID;

        for (const auto& s : stuList) {
            if (s.id == findID) {
                cout << "\n========== Student Found ==========" << endl;
                cout << "Student ID:   " << s.id << endl;
                cout << "Student Name: " << s.name << endl;
                cout << "Student Score:" << s.score << endl;
                cout << "===================================" << endl;
                return;
            }
        }
        cout << "[Error] No such student found!" << endl;
    }

    /**
     * Modify student score
     */
    void modifyScore() {
        if (stuList.empty()) {
            cout << "[Info] There is no data for any student." << endl;
            return;
        }

        int modifyID;
        cout << "Please enter the student ID to modify: ";
        cin >> modifyID;

        for (auto& s : stuList) {
            if (s.id == modifyID) {
                cout << "Original Score: " << s.score << endl;
                cout << "Please enter the new score: ";
                cin >> s.score;

                if (s.score < 0 || s.score > 100) {
                    cout << "[Error] The score is not reasonable. Modification failed." << endl;
                    return;
                }

                saveToFile();
                cout << "[Success] Modified successfully! New score: " << s.score << endl;
                return;
            }
        }
        cout << "[Error] Modification failed! No such student." << endl;
    }

    /**
     * Delete a student by ID
     */
    void deleteStudent() {
        if (stuList.empty()) {
            cout << "[Info] There is no data for any student." << endl;
            return;
        }

        int deleteID;
        cout << "Please enter the student ID to delete: ";
        cin >> deleteID;

        for (auto it = stuList.begin(); it != stuList.end(); ++it) {
            if (it->id == deleteID) {
                stuList.erase(it);
                saveToFile();
                cout << "[Success] Delete successfully!" << endl;
                return;
            }
        }
        cout << "[Error] Delete failed! No such student." << endl;
    }

    /**
     * Count failing students (score < 60)
     */
    void countFailing() const {
        if (stuList.empty()) {
            cout << "[Info] There is no data for any student." << endl;
            return;
        }

        int cnt = 0;
        for (const auto& s : stuList) {
            if (s.score < 60) cnt++;
        }
        cout << "The number of failing students: " << cnt << endl;
    }

    /**
     * Clear all student data
     */
    void clearAll() {
        cout << "Are you sure to CLEAR ALL? 0 = Cancel, 1 = Confirm: ";
        int op;
        cin >> op;

        if (op == 1) {
            stuList.clear();
            saveToFile();
            cout << "[Success] Clear all successfully." << endl;
        } else {
            cout << "[Info] Canceled successfully." << endl;
        }
    }

    /**
     * Calculate score statistics (average, max, min)
     */
    void scoreStatistics() const {
        if (stuList.empty()) {
            cout << "[Info] There is no student now!" << endl;
            return;
        }

        int sum = 0;
        int maxScore = stuList[0].score;
        int minScore = stuList[0].score;

        for (const auto& s : stuList) {
            sum += s.score;
            if (s.score > maxScore) maxScore = s.score;
            if (s.score < minScore) minScore = s.score;
        }

        double avg = static_cast<double>(sum) / stuList.size();
        cout << fixed << setprecision(2);
        cout << "\n========== Score Statistics ==========" << endl;
        cout << "Average: " << avg << endl;
        cout << "Maximum: " << maxScore << endl;
        cout << "Minimum: " << minScore << endl;
        cout << "======================================" << endl;
    }

    /**
     * Display score range distribution
     */
    void scoreRange() const {
        if (stuList.empty()) {
            cout << "[Info] There is no data for any student." << endl;
            return;
        }

        int a = 0, b = 0, c = 0, d = 0, e = 0;
        for (const auto& s : stuList) {
            if (s.score >= 90) a++;
            else if (s.score >= 80) b++;
            else if (s.score >= 70) c++;
            else if (s.score >= 60) d++;
            else e++;
        }

        cout << "\n========== Score Range Distribution ==========" << endl;
        cout << "90 - 100 : " << a << " students" << endl;
        cout << "80 - 89  : " << b << " students" << endl;
        cout << "70 - 79  : " << c << " students" << endl;
        cout << "60 - 69  : " << d << " students" << endl;
        cout << "Below 60 : " << e << " students" << endl;
        cout << "==============================================" << endl;
    }

    /**
     * Fuzzy search by name
     */
    void fuzzySearch() const {
        if (stuList.empty()) {
            cout << "[Info] There is no data for any student." << endl;
            return;
        }

        string key;
        cout << "Please enter the name keyword: ";
        cin >> key;

        bool found = false;
        cout << "\n========== Search Results ==========" << endl;
        for (const auto& s : stuList) {
            if (s.name.find(key) != string::npos) {
                cout << s.id << "\t" << s.name << "\t" << s.score << endl;
                found = true;
            }
        }
        cout << "====================================" << endl;

        if (!found) {
            cout << "[Info] No match found!" << endl;
        }
    }

    /**
     * Display students by page
     */
    void pageDisplay() const {
        if (stuList.empty()) {
            cout << "[Info] There is no data for any student." << endl;
            return;
        }

        int pageSize = 3;
        cout << "Please enter page size (default 3): ";
        cin >> pageSize;

        if (pageSize <= 0) {
            cout << "[Error] Invalid page size." << endl;
            return;
        }

        int total = stuList.size();
        int pages = total / pageSize;
        if (total % pageSize != 0) pages++;

        cout << "Total pages: " << pages << endl;
        cout << "Please enter the page you want to view: ";
        int page;
        cin >> page;

        if (page < 1 || page > pages) {
            cout << "[Error] Invalid page number." << endl;
            return;
        }

        int start = (page - 1) * pageSize;
        int end = min(start + pageSize, total);

        cout << "\n========== Page " << page << " / " << pages << " ==========" << endl;
        cout << "ID\tName\t\tScore" << endl;
        cout << "--------------------------------" << endl;
        for (int i = start; i < end; i++) {
            cout << stuList[i].id << "\t" << stuList[i].name << "\t\t" << stuList[i].score << endl;
        }
        cout << "================================" << endl;
    }

    /**
     * Get current student count
     */
    int getCount() const {
        return stuList.size();
    }
};

