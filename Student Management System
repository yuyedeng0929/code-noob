int getOption() {
    int option;
    while (true) {
        showMenu();
        if (cin >> option) {
            if (option >= 0 && option <= 15) {
                return option;
            }
            cout << "[Error] Option out of range (0-15)." << endl;
        } else {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "[Error] Invalid input." << endl;
        }
    }
}

int main() {
    AdminSystem auth;
    while (!auth.login()) {
        cout << "Please try again." << endl;
    }

    StudentManager manager;
    string user = auth.getCurrentUser();

    cout << "\nWelcome, " << user << "!" << endl;
    cout << "Loaded " << manager.getCount() << " student(s)." << endl;

    while (true) {
        int option = getOption();
        switch (option) {
            case 0:
                auth.logout();
                cout << "\n[Info] Saving and exiting..." << endl;
                cout << "Goodbye, " << user << "!" << endl;
                return 0;
            case 1: manager.addStudent(user); break;
            case 2: manager.displayAll(); break;
            case 3: manager.sortStudents(user); break;
            case 4: manager.searchByID(); break;
            case 5: manager.modifyScore(user); break;
            case 6: manager.deleteStudent(user); break;
            case 7: manager.countFailing(); break;
            case 8: manager.clearAll(user); break;
            case 9: manager.scoreStatistics(); break;
            case 10: manager.scoreRange(); break;
            case 11: manager.fuzzySearch(); break;
            case 12: manager.pageDisplay(); break;
            case 13: manager.exportReport(user); break;
            case 14: manager.viewLogs(); break;
            case 15: auth.registerUser(); break;
            default: cout << "[Error] Invalid option." << endl;
        }
    }
    return 0;
}
