/**
 * Get valid menu option from user
 */
int getOption() {
    int option;
    while (true) {
        showMenu();
        if (cin >> option) {
            if (option >= 0 && option <= 12) {
                return option;
            }
            cout << "[Error] Option out of range (0-12). Please try again." << endl;
        } else {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "[Error] Input contains non-numeric characters. Please enter again." << endl;
        }
    }
}

/**
 * Main function
 */
int main() {
    StudentManager manager;  // Automatically loads data from file

    cout << "Welcome to Student Management System!" << endl;
    cout << "Loaded " << manager.getCount() << " student(s) from file." << endl;

    while (true) {
        int option = getOption();

        switch (option) {
            case 0:
                cout << "\n[Info] Saving data and exiting..." << endl;
                cout << "You have exited the system. Goodbye!" << endl;
                return 0;
            case 1: manager.addStudent(); break;
            case 2: manager.displayAll(); break;
            case 3: manager.sortStudents(); break;
            case 4: manager.searchByID(); break;
            case 5: manager.modifyScore(); break;
            case 6: manager.deleteStudent(); break;
            case 7: manager.countFailing(); break;
            case 8: manager.clearAll(); break;
            case 9: manager.scoreStatistics(); break;
            case 10: manager.scoreRange(); break;
            case 11: manager.fuzzySearch(); break;
            case 12: manager.pageDisplay(); break;
            default:
                cout << "[Error] Invalid option." << endl;
        }
    }

    return 0;
}
