struct Student {
    string name;
    int score;
    int id;
};

struct LogEntry {
    string timestamp;
    string user;
    string action;
    string details;
};

class AdminSystem {
private:
    map<string, string> users;
    string currentUser;
    const string DATA_DIR = "StudentSystemData";
    const string USER_FILE = DATA_DIR + "/users.txt";

    void ensureDataDir() {
        if (!fs::exists(DATA_DIR)) {
            fs::create_directory(DATA_DIR);
        }
    }

    void loadUsers() {
        ensureDataDir();
        ifstream inFile(USER_FILE);
        if (!inFile.is_open()) {
            users["admin"] = "123456";
            saveUsers();
            return;
        }
        string username, password;
        while (inFile >> username >> password) {
            users[username] = password;
        }
        inFile.close();
    }

    void saveUsers() const {
        ofstream outFile(USER_FILE);
        for (const auto& pair : users) {
            outFile << pair.first << " " << pair.second << endl;
        }
        outFile.close();
    }

public:
    AdminSystem() {
        ensureDataDir();
        loadUsers();
        currentUser = "";
    }

    bool login() {
        string username, password;
        cout << "\n========== Login ==========" << endl;
        cout << "Username: ";
        cin >> username;
        cout << "Password: ";
        cin >> password;

        auto it = users.find(username);
        if (it != users.end() && it->second == password) {
            currentUser = username;
            cout << "[Success] Welcome, " << username << "!" << endl;
            return true;
        }
        cout << "[Error] Invalid username or password!" << endl;
        return false;
    }

    void registerUser() {
        string username, password;
        cout << "Enter new username: ";
        cin >> username;
        if (users.find(username) != users.end()) {
            cout << "[Error] Username already exists!" << endl;
            return;
        }
        cout << "Enter password: ";
        cin >> password;
        users[username] = password;
        saveUsers();
        cout << "[Success] User registered!" << endl;
    }

    string getCurrentUser() const { return currentUser; }
    bool isLoggedIn() const { return !currentUser.empty(); }
    void logout() { currentUser = ""; }
};

class StudentManager {
private:
    vector<Student> stuList;
    map<int, int> idMap;
    vector<LogEntry> logs;

    const string DATA_DIR = "StudentSystemData";
    const string FILENAME = DATA_DIR + "/Students.txt";
    const string LOG_FILE = DATA_DIR + "/operation.log";

    string getCurrentTime() const {
        time_t now = time(0);
        tm* ltm = localtime(&now);
        char buf[20];
        sprintf(buf, "%04d-%02d-%02d %02d:%02d:%02d",
                1900 + ltm->tm_year, 1 + ltm->tm_mon, ltm->tm_mday,
                ltm->tm_hour, ltm->tm_min, ltm->tm_sec);
        return string(buf);
    }

    void ensureDataDir() const {
        if (!fs::exists(DATA_DIR)) {
            fs::create_directory(DATA_DIR);
        }
    }

    void addLog(const string& user, const string& action, const string& details) {
        LogEntry entry;
        entry.timestamp = getCurrentTime();
        entry.user = user;
        entry.action = action;
        entry.details = details;
        logs.push_back(entry);

        ensureDataDir();
        ofstream outFile(LOG_FILE, ios::app);
        if (outFile.is_open()) {
            outFile << "[" << entry.timestamp << "] "
                    << "[" << entry.user << "] "
                    << "[" << entry.action << "] "
                    << entry.details << endl;
            outFile.close();
        }
    }

    void saveToFile() const {
        ensureDataDir();
        ofstream outFile(FILENAME);
        if (!outFile.is_open()) {
            cout << "[Error] Failed to open file for saving." << endl;
            return;
        }
        for (const auto& s : stuList) {
            outFile << s.name << " " << s.id << " " << s.score << endl;
        }
        outFile.close();
    }

    void loadFromFile() {
        ensureDataDir();
        ifstream inFile(FILENAME);
        if (!inFile.is_open()) return;
        Student stu;
        while (inFile >> stu.name >> stu.id >> stu.score) {
            if (!isIDExist(stu.id)) {
                stuList.push_back(stu);
            }
        }
        inFile.close();
        rebuildIdMap();
    }

    void rebuildIdMap() {
        idMap.clear();
        for (size_t i = 0; i < stuList.size(); i++) {
            idMap[stuList[i].id] = i;
        }
    }

    bool isIDExist(int id) const {
        return idMap.find(id) != idMap.end();
    }

    static bool cmpScoreDesc(const Student& a, const Student& b) {
        return a.score > b.score;
    }
    static bool cmpScoreAsc(const Student& a, const Student& b) {
        return a.score < b.score;
    }
    static bool cmpID(const Student& a, const Student& b) {
        return a.id < b.id;
    }
    static bool cmpName(const Student& a, const Student& b) {
        return a.name < b.name;
    }

public:
    StudentManager() {
        ensureDataDir();
        loadFromFile();
    }

    ~StudentManager() {
        saveToFile();
    }

    void addStudent(const string& user) {
        Student stu;
        cout << "Please enter the name: ";
        cin >> stu.name;
        cout << "Please enter the id: ";
        cin >> stu.id;
        if (isIDExist(stu.id)) {
            cout << "[Error] The id is duplicated." << endl;
            return;
        }
        cout << "Please enter the score: ";
        cin >> stu.score;
        if (stu.score < 0 || stu.score > 100) {
            cout << "[Error] Invalid score (0-100)." << endl;
            return;
        }
        stuList.push_back(stu);
        rebuildIdMap();
        saveToFile();
        addLog(user, "ADD", "Added: " + stu.name + " (ID:" + to_string(stu.id) + ", Score:" + to_string(stu.score) + ")");
        cout << "[Success] Student added!" << endl;
    }

    void displayAll() const {
        if (stuList.empty()) {
            cout << "[Info] No data available." << endl;
            return;
        }
        cout << "\n========== Student List ==========" << endl;
        cout << left << setw(15) << "Name" << setw(10) << "ID" << setw(10) << "Score" << endl;
        cout << "------------------------------------------" << endl;
        for (const auto& s : stuList) {
            cout << left << setw(15) << s.name << setw(10) << s.id << setw(10) << s.score << endl;
        }
        cout << "==================================" << endl;
    }

    void sortStudents(const string& user) {
        if (stuList.empty()) {
            cout << "[Info] No data available." << endl;
            return;
        }
        int op = 0;
        cout << "Choose sorting method:" << endl;
        cout << "  1 -- Score (Descending)" << endl;
        cout << "  2 -- Score (Ascending)" << endl;
        cout << "  3 -- ID" << endl;
        cout << "  4 -- Name" << endl;
        cout << "Your choice: ";
        cin >> op;

        string sortType;
        switch (op) {
            case 1: sort(stuList.begin(), stuList.end(), cmpScoreDesc); sortType = "Score Descending"; break;
            case 2: sort(stuList.begin(), stuList.end(), cmpScoreAsc); sortType = "Score Ascending"; break;
            case 3: sort(stuList.begin(), stuList.end(), cmpID); sortType = "ID"; break;
            case 4: sort(stuList.begin(), stuList.end(), cmpName); sortType = "Name"; break;
            default: cout << "[Error] Invalid option." << endl; return;
        }
        rebuildIdMap();
        saveToFile();
        addLog(user, "SORT", "Sorted by: " + sortType);
        cout << "[Success] Sorted by " << sortType << "!" << endl;
    }

    void searchByID() const {
        if (stuList.empty()) {
            cout << "[Info] No data available." << endl;
            return;
        }
        int findID;
        cout << "Please enter the student ID: ";
        cin >> findID;

        auto it = idMap.find(findID);
        if (it != idMap.end()) {
            const Student& s = stuList[it->second];
            cout << "\n========== Student Found ==========" << endl;
            cout << "ID:    " << s.id << endl;
            cout << "Name:  " << s.name << endl;
            cout << "Score: " << s.score << endl;
            cout << "===================================" << endl;
            return;
        }
        cout << "[Error] No such student!" << endl;
    }

    void modifyScore(const string& user) {
        if (stuList.empty()) {
            cout << "[Info] No data available." << endl;
            return;
        }
        int modifyID;
        cout << "Please enter the student ID: ";
        cin >> modifyID;

        auto it = idMap.find(modifyID);
        if (it == idMap.end()) {
            cout << "[Error] No such student!" << endl;
            return;
        }

        Student& s = stuList[it->second];
        int oldScore = s.score;
        cout << "Original Score: " << oldScore << endl;
        cout << "Please enter new score: ";
        cin >> s.score;

        if (s.score < 0 || s.score > 100) {
            s.score = oldScore;
            cout << "[Error] Invalid score. Modification cancelled." << endl;
            return;
        }

        saveToFile();
        addLog(user, "MODIFY", "Modified ID:" + to_string(modifyID) + " from " + to_string(oldScore) + " to " + to_string(s.score));
        cout << "[Success] Score updated!" << endl;
    }

    void deleteStudent(const string& user) {
        if (stuList.empty()) {
            cout << "[Info] No data available." << endl;
            return;
        }
        int deleteID;
        cout << "Please enter the student ID: ";
        cin >> deleteID;

        auto it = idMap.find(deleteID);
        if (it == idMap.end()) {
            cout << "[Error] No such student!" << endl;
            return;
        }

        string deletedName = stuList[it->second].name;
        stuList.erase(stuList.begin() + it->second);
        rebuildIdMap();
        saveToFile();
        addLog(user, "DELETE", "Deleted: " + deletedName + " (ID:" + to_string(deleteID) + ")");
        cout << "[Success] Student deleted!" << endl;
    }

    void countFailing() const {
        if (stuList.empty()) {
            cout << "[Info] No data available." << endl;
            return;
        }
        int cnt = 0;
        for (const auto& s : stuList) {
            if (s.score < 60) cnt++;
        }
        cout << "Failing students (<60): " << cnt << endl;
    }

    void clearAll(const string& user) {
        cout << "Confirm CLEAR ALL? 0=Cancel, 1=Confirm: ";
        int op;
        cin >> op;
        if (op == 1) {
            int count = stuList.size();
            stuList.clear();
            idMap.clear();
            saveToFile();
            addLog(user, "CLEAR", "Cleared all " + to_string(count) + " students");
            cout << "[Success] All data cleared!" << endl;
        } else {
            cout << "[Info] Cancelled." << endl;
        }
    }

    void scoreStatistics() const {
        if (stuList.empty()) {
            cout << "[Info] No data available." << endl;
            return;
        }
        int sum = 0, maxScore = stuList[0].score, minScore = stuList[0].score;
        for (const auto& s : stuList) {
            sum += s.score;
            if (s.score > maxScore) maxScore = s.score;
            if (s.score < minScore) minScore = s.score;
        }
        double avg = static_cast<double>(sum) / stuList.size();
        cout << fixed << setprecision(2);
        cout << "\n========== Statistics ==========" << endl;
        cout << "Average: " << avg << endl;
        cout << "Maximum: " << maxScore << endl;
        cout << "Minimum: " << minScore << endl;
        cout << "Total:   " << stuList.size() << endl;
        cout << "================================" << endl;
    }

    void scoreRange() const {
        if (stuList.empty()) {
            cout << "[Info] No data available." << endl;
            return;
        }
        int a = 0, b = 0, c = 0, d = 0, e = 0;
        for (const auto& s : stuList) {
            if (s.score >= 90) a++;
            else if (s.score >= 80) b++;
            else if (s.score >= 70) c++;
            else if (s.score >= 60) d++;
            else e++;
        }
        cout << "\n========== Score Distribution ==========" << endl;
        cout << "90-100: " << a << " (" << fixed << setprecision(1) << (100.0*a/stuList.size()) << "%)" << endl;
        cout << "80-89:  " << b << " (" << (100.0*b/stuList.size()) << "%)" << endl;
        cout << "70-79:  " << c << " (" << (100.0*c/stuList.size()) << "%)" << endl;
        cout << "60-69:  " << d << " (" << (100.0*d/stuList.size()) << "%)" << endl;
        cout << "<60:    " << e << " (" << (100.0*e/stuList.size()) << "%)" << endl;
        cout << "=======================================" << endl;
    }

    void fuzzySearch() const {
        if (stuList.empty()) {
            cout << "[Info] No data available." << endl;
            return;
        }
        string key;
        cout << "Enter name keyword: ";
        cin >> key;
        bool found = false;
        cout << "\n========== Search Results ==========" << endl;
        for (const auto& s : stuList) {
            if (s.name.find(key) != string::npos) {
                cout << s.id << "\t" << s.name << "\t" << s.score << endl;
                found = true;
            }
        }
        cout << "====================================" << endl;
        if (!found) cout << "[Info] No match." << endl;
    }

    void pageDisplay() const {
        if (stuList.empty()) {
            cout << "[Info] No data available." << endl;
            return;
        }
        int pageSize;
        cout << "Page size: ";
        cin >> pageSize;
        if (pageSize <= 0) {
            cout << "[Error] Invalid." << endl;
            return;
        }
        int total = stuList.size();
        int pages = (total + pageSize - 1) / pageSize;
        cout << "Total pages: " << pages << endl;
        cout << "Page number: ";
        int page;
        cin >> page;
        if (page < 1 || page > pages) {
            cout << "[Error] Invalid page." << endl;
            return;
        }
        int start = (page - 1) * pageSize;
        int end = min(start + pageSize, total);
        cout << "\n========== Page " << page << "/" << pages << " ==========" << endl;
        cout << left << setw(10) << "ID" << setw(15) << "Name" << "Score" << endl;
        cout << "--------------------------------" << endl;
        for (int i = start; i < end; i++) {
            cout << left << setw(10) << stuList[i].id << setw(15) << stuList[i].name << stuList[i].score << endl;
        }
        cout << "================================" << endl;
    }

    void exportReport(const string& user) const {
        if (stuList.empty()) {
            cout << "[Info] No data to export." << endl;
            return;
        }
        ensureDataDir();
        string reportFile = DATA_DIR + "/report_" + getCurrentTime().substr(0, 10) + ".txt";
        ofstream outFile(reportFile);
        if (!outFile.is_open()) {
            cout << "[Error] Cannot create report file." << endl;
            return;
        }

        int sum = 0, maxScore = stuList[0].score, minScore = stuList[0].score;
        int pass = 0, fail = 0;
        for (const auto& s : stuList) {
            sum += s.score;
            if (s.score > maxScore) maxScore = s.score;
            if (s.score < minScore) minScore = s.score;
            if (s.score >= 60) pass++; else fail++;
        }
        double avg = static_cast<double>(sum) / stuList.size();

        outFile << "============================================" << endl;
        outFile << "       STUDENT MANAGEMENT REPORT            " << endl;
        outFile << "============================================" << endl;
        outFile << "Generated: " << getCurrentTime() << endl;
        outFile << "Generated by: " << user << endl;
        outFile << "--------------------------------------------" << endl;
        outFile << "Total Students: " << stuList.size() << endl;
        outFile << "Average Score:  " << fixed << setprecision(2) << avg << endl;
        outFile << "Highest Score:  " << maxScore << endl;
        outFile << "Lowest Score:   " << minScore << endl;
        outFile << "Pass Count:     " << pass << endl;
        outFile << "Fail Count:     " << fail << endl;
        outFile << "--------------------------------------------" << endl;
        outFile << left << setw(10) << "ID" << setw(15) << "Name" << "Score" << endl;
        outFile << "--------------------------------------------" << endl;
        for (const auto& s : stuList) {
            outFile << left << setw(10) << s.id << setw(15) << s.name << s.score << endl;
        }
        outFile << "============================================" << endl;
        outFile.close();

        addLog(user, "EXPORT", "Exported report to: " + reportFile);
        cout << "[Success] Report exported to: " << reportFile << endl;
    }

    void viewLogs() const {
        string logPath = DATA_DIR + "/operation.log";
        ifstream inFile(logPath);
        if (!inFile.is_open()) {
            cout << "[Info] No logs available." << endl;
            return;
        }
        cout << "\n========== Operation Logs ==========" << endl;
        string line;
        int count = 0;
        while (getline(inFile, line)) {
            cout << line << endl;
            count++;
            if (count % 20 == 0) {
                cout << "-- Press Enter to continue --" << endl;
                cin.get();
            }
        }
        cout << "====================================" << endl;
        inFile.close();
    }

    int getCount() const { return stuList.size(); }
};

